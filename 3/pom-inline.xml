<?xml version="1.0" encoding="UTF-8"?>
<project>
  <build>
    <plugins>

      <!-- jib-maven-plugin: образ inline в одну строку -->
      <plugin>
        <groupId>com.google.cloud.tools</groupId>
        <artifactId>jib-maven-plugin</artifactId>
        <configuration>
          <from>
            <image>gcr.io/distroless/java17:1.0.0</image>
          </from>
          <to>
            <image>myregistry.io/myapp:2.3.1</image>
          </to>
        </configuration>
      </plugin>

      <!-- docker-maven-plugin: теги <imageName> и <baseImage> -->
      <plugin>
        <groupId>io.fabric8</groupId>
        <artifactId>docker-maven-plugin</artifactId>
        <configuration>
          <imageName>myregistry.io/service-b:1.4.0</imageName>
          <baseImage>docker.io/eclipse-temurin/17-jre-alpine:17.0.9</baseImage>
        </configuration>
      </plugin>

    </plugins>
  </build>
</project>
